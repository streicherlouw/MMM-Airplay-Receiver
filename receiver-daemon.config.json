{
  "receiverName": "Art Wall",
  "uxplayPath": "/usr/local/bin/uxplay",
  "fullscreen": false,
  "pin": false,
  "persistTrustedClients": false,
  "port": 7000,
  "resolution": "1920x1080@60",
  "fps": 60,
  "lowLatency": true,
  "noFreeze": true,
  "inhibitScreensaver": false,
  "videoSink": "waylandsink fullscreen=true sync=false async=false enable-last-sample=false processing-deadline=0",
  "audioSink": "pulsesink sync=false async=false buffer-time=20000 latency-time=10000 processing-deadline=0",
  "waylandDisplay": "wayland-0",
  "xdgRuntimeDir": "/run/user/1000",
  "dbusSessionBusAddress": "unix:path=/run/user/1000/bus",
  "useBt709": true,
  "extraArgs": [
    "-FPSdata",
    "-vd",
    "v4l2h264dec capture-io-mode=mmap output-io-mode=mmap",
    "-vc",
    "videoconvert",
    "-db",
    "-50:0",
    "-taper",
    "-srgb",
    "no"
  ],
  "restartOnExit": true,
  "restartDelay": 5000,
  "externalStatusFile": "/run/user/1000/mmm-airplay-receiver-status.json",
  "manageMagicMirror": true,
  "pm2Path": "/usr/local/bin/pm2",
  "pm2ProcessName": "MagicMirror",
  "manageSystemVolume": true,
  "systemVolumeLimitPercent": 100,
  "systemVolumeTarget": "@DEFAULT_AUDIO_SINK@",
  "wpctlPath": "/usr/bin/wpctl",
  "manageDisplayPower": true,
  "displayOutput": "HDMI-A-1",
  "wlrRandrPath": "/usr/bin/wlr-randr",
  "receiverOutputSampleLines": 0,
  "performanceReportSamples": 3,
  "debugReceiver": true
}
